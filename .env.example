# Copy this file to .env and edit the values:  cp .env.example .env
# .env is never committed (it is listed in .gitignore).

# Windows user and password (change them)
WIN_USER=trader
WIN_PASSWORD=change-this-password

# Absolute path to the Tiny11 ISO (see README > "Download the Tiny11 ISO")
WIN_ISO=/home/YOUR_USER/Downloads/tiny11 b1.iso

# Only used if you remove the ISO line from docker-compose.yml.
# 11l = Windows 11 LTSC | tiny11 = Tiny11 | core11 = Tiny11 Core | 11 = Windows 11 Pro
WIN_VERSION=11l

# Virtual machine resources (Tiny11 runs fine with 2G; use 4G+ for heavy charting)
RAM_SIZE=2G
CPU_CORES=2
DISK_SIZE=32G

# 127.0.0.1 = reachable only from this PC (recommended)
# 0.0.0.0   = reachable from your network (only if you know what you are doing)
BIND_IP=127.0.0.1
